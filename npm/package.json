{
  "name": "mangekyo-agent-js",
  "version": "0.1.0",
  "description": "Local trace capture for TypeScript agents",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./openai-agents": {
      "types": "./src/openai-agents.d.ts",
      "default": "./src/openai-agents.js"
    },
    "./claude-agent-sdk": {
      "types": "./src/claude-agent-sdk.d.ts",
      "default": "./src/claude-agent-sdk.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/recorder.test.js",
    "typecheck": "tsc --project tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agents",
    "observability",
    "tracing",
    "typescript",
    "openai"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jweng121/mangekyo-agent.git",
    "directory": "npm"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@openai/agents": "^0.22.0",
    "typescript": "^7.0.2"
  }
}
